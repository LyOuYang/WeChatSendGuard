import { AboutSlint } from "std-widgets.slint";

export struct ChatRow {
    id: string,
    display-name: string,
    detail: string,
    kind-label: string,
    enabled: bool,
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: area.pressed ? #def7ec : (root.selected ? #eaf8f1 : (area.has-hover ? #f1f5f9 : #00000000));
    animate background { duration: 150ms; easing: ease-out; }

    if (root.selected) : Rectangle {
        x: 4px;
        y: 9px;
        width: 3.5px;
        height: parent.height - 18px;
        border-radius: 2px;
        background: #07c160;
    }

    label-text := Text {
        x: 16px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: root.selected ? #059669 : (area.has-hover ? #0f172a : #475569);
        font-size: 13px;
        font-weight: root.selected ? 700 : 400;
        vertical-alignment: center;
        animate color { duration: 120ms; }
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component AppButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> active: true;
    callback clicked();

    height: 34px;
    min-width: 60px;
    border-radius: 7px;
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger ? (area.has-hover ? #f87171 : #fca5a5) : (area.has-hover ? #cbd5e1 : #e2e8f0);
    background: !root.active ? #f1f5f9 : 
        (root.primary ? 
            (area.pressed ? #059b4c : (area.has-hover ? #06ad56 : #07c160)) : 
            (root.danger ? 
                (area.pressed ? #fecaca : (area.has-hover ? #fee2e2 : #fff5f5)) : 
                (area.pressed ? #f1f5f9 : (area.has-hover ? #f8fafc : #ffffff))));
    opacity: root.active ? 1.0 : 0.45;
    animate background { duration: 120ms; easing: ease-out; }
    animate border-color { duration: 120ms; easing: ease-out; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.primary ? #ffffff : (root.danger ? #dc2626 : #334155);
        font-size: 13px;
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        enabled: root.active;
        clicked => { root.clicked(); }
    }
}

component WindowControlButton inherits Rectangle {
    in property <string> symbol: "";
    in property <bool> close-action: false;
    callback clicked();

    width: 46px;
    height: 38px;
    background: area.pressed ? 
        (root.close-action ? #b91c1c : #e2e8f0) : 
        (area.has-hover ? (root.close-action ? #e81123 : #f1f5f9) : #00000000);
    animate background { duration: 120ms; easing: ease-out; }

    if (!root.close-action) : Rectangle {
        width: 11px;
        height: 1.2px;
        y: (parent.height - self.height) / 2;
        x: (parent.width - self.width) / 2;
        background: area.pressed ? #0f172a : (area.has-hover ? #1e293b : #64748b);
    }

    if (root.close-action) : Path {
        width: 10px;
        height: 10px;
        y: (parent.height - self.height) / 2;
        x: (parent.width - self.width) / 2;
        stroke: area.has-hover ? #ffffff : #64748b;
        stroke-width: 1.2px;
        commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component InputField inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;
    in property <bool> valid: true;
    callback edited();

    height: 34px;
    border-radius: 7px;
    border-width: root.valid ? (input.has-focus ? 1.5px : 1px) : 1.5px;
    border-color: root.valid ? (input.has-focus ? #07c160 : #e2e8f0) : #dc2626;
    background: #ffffff;
    clip: true;
    animate border-color { duration: 120ms; easing: ease-out; }

    input := TextInput {
        x: 10px;
        y: 0px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.value;
        color: #0f172a;
        font-size: 13px;
        vertical-alignment: center;
        edited => { root.edited(); }
    }
    public function focus-input() {
        input.focus();
    }
    Text {
        x: 11px;
        y: 0px;
        width: parent.width - 22px;
        height: parent.height;
        visible: root.value == "";
        text: root.placeholder;
        color: #94a3b8;
        font-size: 13px;
        vertical-alignment: center;
    }
}

component ToggleLine inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <bool> checked;
    callback toggled(bool);

    height: root.note == "" ? 38px : 46px;
    background: #00000000;

    switch := Rectangle {
        x: 0px;
        y: (parent.height - 22px) / 2;
        width: 38px;
        height: 22px;
        border-radius: 11px;
        background: root.checked ? #07c160 : #cbd5e1;
        animate background { duration: 150ms; easing: ease-out; }
        handle := Rectangle {
            x: root.checked ? 18px : 2px;
            y: 2px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: #ffffff;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }
    Text {
        x: 48px;
        y: root.note == "" ? 0px : 3px;
        width: parent.width - 48px;
        height: 20px;
        text: root.label;
        color: #1e293b;
        font-size: 13px;
        font-weight: 400;
        vertical-alignment: center;
    }
    Text {
        x: 48px;
        y: 23px;
        width: parent.width - 48px;
        height: 18px;
        visible: root.note != "";
        text: root.note;
        color: #64748b;
        font-size: 12px;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.toggled(!root.checked); }
    }
}

component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> warning;
    callback clicked();

    height: 66px;
    border-radius: 9px;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? (root.warning ? #f59e0b : #10b981) : (area.has-hover ? #cbd5e1 : #e2e8f0);
    background: root.selected ? (root.warning ? #fffbeb : #f0fdf4) : (area.has-hover ? #f8fafc : #ffffff);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Text {
        x: 14px;
        y: 11px;
        width: parent.width - 52px;
        height: 20px;
        text: root.title;
        color: #0f172a;
        font-size: 13px;
        font-weight: 700;
    }
    Text {
        x: 14px;
        y: 33px;
        width: parent.width - 52px;
        height: 24px;
        text: root.detail;
        color: #64748b;
        font-size: 12px;
        wrap: word-wrap;
    }
    indicator := Rectangle {
        x: parent.width - 32px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: 1.5px;
        border-color: root.selected ? (root.warning ? #d97706 : #07c160) : #cbd5e1;
        background: #00000000;
        Rectangle {
            x: 4px;
            y: 4px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.selected ? (root.warning ? #d97706 : #07c160) : #00000000;
        }
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ConfirmationModeOption inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected: false;
    callback clicked();

    height: 62px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.selected ? #07c160 : (area.has-hover ? #cbd5e1 : #e2e8f0);
    background: root.selected ? #eaf8f1 : (area.has-hover ? #f8fafc : #ffffff);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Text {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: 18px;
        text: root.title;
        color: root.selected ? #047857 : #1e293b;
        font-size: 13px;
        font-weight: 700;
    }
    Text {
        x: 12px;
        y: 28px;
        width: parent.width - 24px;
        height: 24px;
        text: root.detail;
        color: root.selected ? #047857 : #64748b;
        font-size: 11px;
        wrap: word-wrap;
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ChatListItem inherits Rectangle {
    in property <ChatRow> chat;
    in property <bool> selected;
    callback clicked(string);
    callback remove-clicked(string);

    height: 38px;
    border-radius: 6px;
    background: root.selected ? #f0fdf4 : (main-touch.has-hover ? #f8fafc : #ffffff);
    border-width: 1px;
    border-color: root.selected ? #86efac : (main-touch.has-hover ? #cbd5e1 : #e2e8f0);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    if (root.selected) : Rectangle {
        x: 0px;
        y: 7px;
        width: 3px;
        height: parent.height - 14px;
        border-radius: 1.5px;
        background: #07c160;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;

        badge := Rectangle {
            width: 46px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: root.chat.kind-label == "联系人" ? #ecfdf5 : #eff6ff;
            border-width: 1px;
            border-color: root.chat.kind-label == "联系人" ? #a7f3d0 : #bfdbfe;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.chat.kind-label;
                color: root.chat.kind-label == "联系人" ? #047857 : #1d4ed8;
                font-size: 11px;
                font-weight: 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        name-text := Text {
            horizontal-stretch: 1;
            height: parent.height;
            text: root.chat.display-name;
            color: root.selected ? #0f172a : #1e293b;
            font-size: 13px;
            font-weight: root.selected ? 700 : 400;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        if (main-touch.has-hover || root.selected) : Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: remove-touch.has-hover ? #fee2e2 : #00000000;
            animate background { duration: 100ms; }

            Path {
                width: 9px;
                height: 9px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                stroke: remove-touch.has-hover ? #ef4444 : #94a3b8;
                stroke-width: 1.3px;
                commands: "M 1 1 L 8 8 M 8 1 L 1 8";
            }

            remove-touch := TouchArea {
                clicked => { root.remove-clicked(root.chat.id); }
            }
        }
    }

    main-touch := TouchArea {
        width: parent.width - 36px;
        height: parent.height;
        clicked => { root.clicked(root.chat.id); }
    }
}

export component AppWindow inherits Window {
    title: "WeChatSendGuard";
    icon: @image-url("../assets/tray.svg");
    width: 920px;
    height: 680px;
    no-frame: true;
    resize-border-width: 8px;
    background: #ffffff;
    default-font-family: "Microsoft YaHei";
    default-font-size: 13px;
    default-font-weight: 400;

    in-out property <int> active-page: 0;
    in-out property <bool> protection-enabled: true;
    in-out property <int> rule-mode: 0;
    in-out property <[ChatRow]> active-chats;
    in-out property <string> selected-chat-id: "";
    in-out property <string> status-text: "正在检测微信...";
    in-out property <bool> status-healthy: false;
    in-out property <string> list-title: "需要二次确认的会话";
    in-out property <string> list-description: "名单修改会立即生效";
    in-out property <string> alias-text: "";
    in-out property <string> hold-milliseconds: "800";
    in-out property <string> confirmation-phrase: "确认发送";
    in-out property <string> timeout-seconds: "10";
    in-out property <int> confirmation-mode: 1;
    in-out property <bool> intercept-keyboard-enter: true;
    in-out property <bool> intercept-numpad-enter: true;
    in-out property <bool> intercept-send-button: true;
    in-out property <int> unknown-context-behavior: 0;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> auto-check-updates: true;
    in-out property <string> log-retention-days: "7";
    in-out property <string> weixin-executable-path: "";
    in-out property <string> application-version: "";
    in-out property <string> log-directory: "";
    in-out property <string> update-status-text: "尚未检查更新";
    in-out property <bool> update-status-error: false;
    in-out property <bool> update-available: false;
    in-out property <string> latest-update-version: "";
    in-out property <string> latest-update-notes: "";
    in-out property <string> ignored-update-version: "";
    in-out property <bool> has-unsaved-settings: false;
    in-out property <string> save-status: "就绪";
    in-out property <bool> save-status-error: false;

    callback page-selected(int);
    callback protection-toggled(bool);
    callback rule-mode-selected(int);
    callback add-current-chat();
    callback remove-selected-chat();
    callback import-list();
    callback export-list();
    callback chat-selected(string);
    callback aliases-changed(string);
    callback confirmation-mode-selected(int);
    callback keyboard-enter-toggled(bool);
    callback numpad-enter-toggled(bool);
    callback send-button-toggled(bool);
    callback unknown-context-selected(int);
    callback startup-toggled(bool);
    callback auto-check-updates-toggled(bool);
    callback reset-weixin-executable-path();
    callback save-settings();
    callback check-updates-requested();
    callback automatic-update-found(string);
    callback ignore-update-requested();
    callback clear-ignored-update-requested();
    callback download-update-requested();
    callback open-log-directory-requested();
    callback export-diagnostics-requested();
    callback clear-logs-requested();
    callback minimize-requested();
    callback close-requested();
    callback title-bar-pressed();
    callback title-bar-moved();
    callback confirmation-requested(string);
    callback confirmation-cancel-requested();
    callback about-slint-requested();
    callback settings-dirty();

    frame := Rectangle {
        width: parent.width;
        height: parent.height;
        background: #f8fafc;
        border-width: 1px;
        border-color: #64748b;
        clip: true;
        HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 220px;
            background: #f1f5f9;
            border-width: 1px;
            border-color: #cbd5e1;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    height: 40px;
                    spacing: 10px;
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 8px;
                        background: root.protection-enabled ? #e8f8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: root.protection-enabled ? #bbf7d0 : #e2e8f0;
                        Image {
                            width: 20px;
                            height: 20px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.protection-enabled ? @image-url("../assets/tray-active.svg") : @image-url("../assets/tray-inactive.svg");
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "WeChatSendGuard";
                            color: #0f172a;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "微信发送安全守护";
                            color: #64748b;
                            font-size: 11px;
                            font-weight: 400;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: 10px; background: #00000000; }
                NavItem {
                    label: "守护名单";
                    selected: root.active-page == 0;
                    clicked => { root.active-page = 0; root.page-selected(0); }
                }
                NavItem {
                    label: "确认与拦截";
                    selected: root.active-page == 1;
                    clicked => { root.active-page = 1; root.page-selected(1); }
                }
                NavItem {
                    label: "通用设置";
                    selected: root.active-page == 2;
                    clicked => { root.active-page = 2; root.page-selected(2); }
                }
                NavItem {
                    label: "关于";
                    selected: root.active-page == 3;
                    clicked => { root.active-page = 3; root.page-selected(3); }
                }
                Rectangle { vertical-stretch: 1; background: #00000000; }
                Rectangle {
                    height: 48px;
                    border-radius: 8px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    Rectangle {
                        x: 10px;
                        y: 17px;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: !root.protection-enabled ? #94a3b825 : (root.status-healthy ? #07c16025 : #f59e0b25);
                    }
                    Rectangle {
                        x: 13px;
                        y: 20px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: !root.protection-enabled ? #94a3b8 : (root.status-healthy ? #07c160 : #f59e0b);
                    }
                    Text {
                        x: 30px;
                        y: 0px;
                        width: parent.width - 42px;
                        height: parent.height;
                        text: root.status-text;
                        color: #475569;
                        font-size: 11px;
                        font-weight: 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        Rectangle {
            background: #f8fafc;
            VerticalLayout {
                Rectangle {
                    height: 40px;
                    background: #f8fafc;
                    drag-area := TouchArea {
                        width: parent.width - 92px;
                        height: parent.height;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.title-bar-pressed();
                            }
                        }
                        moved => {
                            root.title-bar-moved();
                        }
                    }
                    WindowControlButton {
                        x: parent.width - 92px;
                        y: 0px;
                        close-action: false;
                        clicked => { root.minimize-requested(); }
                    }
                    WindowControlButton {
                        x: parent.width - 46px;
                        y: 0px;
                        close-action: true;
                        clicked => { root.close-requested(); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: #f8fafc;
                    VerticalLayout {
                        padding-top: 18px;
                        padding-bottom: 18px;
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 12px;

                if (root.active-page == 0) : Rectangle {
                    vertical-stretch: 1;
                    background: #00000000;
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            Text {
                                text: "守护名单";
                                color: #0f172a;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            Rectangle { horizontal-stretch: 1; background: #00000000; }
                            ToggleLine {
                                width: 190px;
                                label: "启用发送保护守护";
                                checked: root.protection-enabled;
                                toggled(value) => { root.protection-enabled = value; root.protection-toggled(value); }
                            }
                        }
                        Text {
                            height: 18px;
                            text: "选择哪些联系人或群聊在发送前需要多一步确认。";
                            color: #6b7280;
                            font-size: 12px;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            ModeCard {
                                horizontal-stretch: 1;
                                title: "仅保护指定名单";
                                detail: "名单内需要确认，名单外直接发送";
                                selected: root.rule-mode == 0;
                                warning: false;
                                clicked => { root.rule-mode = 0; root.rule-mode-selected(0); }
                            }
                            ModeCard {
                                horizontal-stretch: 1;
                                title: "全局防护（白名单模式）";
                                detail: "名单内免确认，其他受支持会话均需确认";
                                selected: root.rule-mode == 1;
                                warning: true;
                                clicked => { root.rule-mode = 1; root.rule-mode-selected(1); }
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            background: #ffffff;
                            VerticalLayout {
                                padding-top: 12px;
                                padding-bottom: 12px;
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: root.list-title; color: #0f172a; font-size: 14px; font-weight: 700; }
                                        Text { text: root.list-description; color: #64748b; font-size: 12px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                                    AppButton { width: 68px; label: "导入"; clicked => { root.import-list(); } }
                                    AppButton { width: 68px; label: "导出"; clicked => { root.export-list(); } }
                                    AppButton { width: 92px; label: "移除选中"; danger: true; active: root.selected-chat-id != ""; clicked => { root.remove-selected-chat(); } }
                                    AppButton { width: 142px; label: "+ 加入当前微信会话"; primary: true; clicked => { root.add-current-chat(); } }
                                }
                                list-box := Rectangle {
                                    vertical-stretch: 1;
                                    clip: true;

                                    property <length> item-height: 38px;
                                    property <length> item-gap: 4px;
                                    property <length> list-total-height: root.active-chats.length == 0 ? 72px : (root.active-chats.length * self.item-height + max(0, root.active-chats.length - 1) * self.item-gap);

                                    list-flick := Flickable {
                                        width: parent.width;
                                        height: parent.height;
                                        viewport-width: parent.width;
                                        viewport-height: max(self.height, list-box.list-total-height);

                                        chat-column := VerticalLayout {
                                            width: parent.width - (list-flick.viewport-height > list-flick.height ? 8px : 0px);
                                            spacing: 4px;
                                            for chat in root.active-chats: ChatListItem {
                                                chat: chat;
                                                selected: root.selected-chat-id == chat.id;
                                                clicked(id) => { root.selected-chat-id = id; root.chat-selected(id); }
                                                remove-clicked(id) => { root.selected-chat-id = id; root.remove-selected-chat(); }
                                            }
                                            if (root.active-chats.length == 0) : Rectangle {
                                                height: 72px;
                                                background: #f8fafc;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: #f1f5f9;
                                                Text {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: "暂无会话，请点击“+ 加入当前微信会话”";
                                                    color: #6b7280;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    font-size: 12px;
                                                }
                                            }
                                        }
                                    }

                                    if (list-flick.viewport-height > list-flick.height) : Rectangle {
                                        x: parent.width - 4px;
                                        y: 2px;
                                        width: 4px;
                                        height: parent.height - 4px;
                                        background: #00000000;

                                        Rectangle {
                                            width: 4px;
                                            height: max(24px, parent.height * (parent.height / list-flick.viewport-height));
                                            y: (parent.height - self.height) * (-list-flick.viewport-y / (list-flick.viewport-height - parent.height));
                                            border-radius: 2px;
                                            background: #94a3b860;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if (root.active-page == 1) : Rectangle {
                    vertical-stretch: 1;
                    background: #00000000;
                    VerticalLayout {
                        spacing: 14px;
                        Text { height: 26px; text: "确认与拦截"; color: #0f172a; font-size: 20px; font-weight: 700; }
                        Text { height: 20px; text: "二次确认只在规则命中时出现；Shift+Enter 始终放行。"; color: #64748b; font-size: 12px; }
                        Rectangle {
                            height: 276px;
                            vertical-stretch: 0;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text { height: 18px; text: "确认方式"; color: #0f172a; font-size: 14px; font-weight: 700; }
                                Text { height: 18px; text: "选择命中守护名单后的继续方式；仅显示当前方式需要的设置。"; color: #64748b; font-size: 11px; }
                                HorizontalLayout {
                                    height: 62px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    ConfirmationModeOption {
                                        horizontal-stretch: 1;
                                        title: "长按确认";
                                        detail: "按住确认按钮 0.8 秒";
                                        selected: root.confirmation-mode == 1;
                                        clicked => { root.confirmation-mode = 1; root.confirmation-mode-selected(1); }
                                    }
                                    ConfirmationModeOption {
                                        horizontal-stretch: 1;
                                        title: "单击确认";
                                        detail: "点击确认按钮即可发送";
                                        selected: root.confirmation-mode == 0;
                                        clicked => { root.confirmation-mode = 0; root.confirmation-mode-selected(0); }
                                    }
                                    ConfirmationModeOption {
                                        horizontal-stretch: 1;
                                        title: "输入确认词";
                                        detail: "输入指定词后才能发送";
                                        selected: root.confirmation-mode == 2;
                                        clicked => { root.confirmation-mode = 2; root.confirmation-mode-selected(2); }
                                    }
                                }
                                Rectangle {
                                    height: 52px;
                                    vertical-stretch: 0;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #e2e8f0;
                                    background: #f8fafc;
                                    if (root.confirmation-mode == 1) : HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text { width: 72px; text: "长按时长"; color: #1e293b; font-size: 12px; vertical-alignment: center; }
                                        InputField { width: 82px; value <=> root.hold-milliseconds; placeholder: "800"; edited => { root.settings-dirty(); } }
                                        Text { width: 24px; text: "毫秒"; color: #475569; font-size: 12px; vertical-alignment: center; }
                                        Text { horizontal-stretch: 1; text: "持续按住达到设定时长后才会发送。"; color: #64748b; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    }
                                    if (root.confirmation-mode == 0) : HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text { width: 72px; text: "单击确认"; color: #1e293b; font-size: 12px; vertical-alignment: center; }
                                        Text { horizontal-stretch: 1; text: "点击“确认发送”即可继续，不需要额外输入。"; color: #64748b; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    }
                                    if (root.confirmation-mode == 2) : HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        Text { width: 72px; text: "确认词"; color: #1e293b; font-size: 12px; vertical-alignment: center; }
                                        InputField { width: 132px; value <=> root.confirmation-phrase; placeholder: "确认发送"; edited => { root.settings-dirty(); } }
                                        Text { horizontal-stretch: 1; text: "发送前必须完整输入该词。"; color: #64748b; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    }
                                }
                                Rectangle { height: 1px; vertical-stretch: 0; background: #e2e8f0; }
                                HorizontalLayout {
                                    height: 34px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    Text { width: 72px; text: "自动取消"; color: #1e293b; font-size: 12px; vertical-alignment: center; }
                                    InputField { width: 72px; value <=> root.timeout-seconds; placeholder: "10"; edited => { root.settings-dirty(); } }
                                    Text { width: 16px; text: "秒"; color: #475569; font-size: 12px; vertical-alignment: center; }
                                    Text { horizontal-stretch: 1; text: "所有确认方式共享；超时后自动取消本次发送。"; color: #64748b; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                }
                            }
                        }
                        Rectangle {
                            height: 142px;
                            vertical-stretch: 0;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;
                                Text { height: 18px; text: "拦截策略"; color: #0f172a; font-size: 14px; font-weight: 700; }
                                HorizontalLayout {
                                    height: 38px;
                                    vertical-stretch: 0;
                                    spacing: 12px;
                                    ToggleLine {
                                        horizontal-stretch: 1;
                                        label: "拦截发送按钮";
                                        note: "";
                                        checked: root.intercept-send-button;
                                        toggled(value) => { root.intercept-send-button = value; root.send-button-toggled(value); }
                                    }
                                    ToggleLine {
                                        horizontal-stretch: 1;
                                        label: "拦截主键盘 Enter";
                                        note: "";
                                        checked: root.intercept-keyboard-enter;
                                        toggled(value) => { root.intercept-keyboard-enter = value; root.keyboard-enter-toggled(value); }
                                    }
                                    ToggleLine {
                                        horizontal-stretch: 1;
                                        label: "拦截数字键盘 Enter";
                                        note: "";
                                        checked: root.intercept-numpad-enter;
                                        toggled(value) => { root.intercept-numpad-enter = value; root.numpad-enter-toggled(value); }
                                    }
                                }
                                Text { height: 18px; text: "发送按钮命中后按当前确认方式处理；关闭主键盘 Enter 后不处理键盘 Enter 发送。"; color: #64748b; font-size: 11px; }
                                Text { height: 18px; text: "Shift+Enter 与输入法候选确认始终放行。"; color: #64748b; font-size: 11px; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: #00000000; }
                    }
                }

                if (root.active-page == 2) : Rectangle {
                    vertical-stretch: 1;
                    background: #00000000;
                    VerticalLayout {
                        spacing: 10px;
                        Text { height: 26px; text: "通用设置"; color: #0f172a; font-size: 20px; font-weight: 700; }
                        Text { height: 20px; text: "所有设置保存在当前 Windows 用户目录，不需要管理员权限。"; color: #64748b; font-size: 12px; }
                        Rectangle {
                            height: 156px;
                            vertical-stretch: 0;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text { text: "微信客户端与未知会话"; color: #0f172a; font-size: 14px; font-weight: 700; }
                                HorizontalLayout {
                                    InputField {
                                        horizontal-stretch: 1;
                                        value <=> root.weixin-executable-path;
                                        placeholder: "C:\\Program Files\\Tencent\\Weixin\\Weixin.exe";
                                        edited => { root.settings-dirty(); }
                                    }
                                    AppButton {
                                        width: 88px;
                                        label: "恢复默认";
                                        clicked => { root.reset-weixin-executable-path(); }
                                    }
                                }
                                Text {
                                    height: 18px;
                                    text: "默认路径已自动填入；客户端版本或 UI Automation 控件不兼容时，应用不会注入按键。";
                                    color: #64748b;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    Text { width: 96px; text: "未知会话处理"; color: #475569; font-size: 12px; vertical-alignment: center; }
                                    AppButton { label: "要求确认"; primary: root.unknown-context-behavior == 0; clicked => { root.unknown-context-behavior = 0; root.unknown-context-selected(0); } }
                                    AppButton { label: "阻止发送"; primary: root.unknown-context-behavior == 1; clicked => { root.unknown-context-behavior = 1; root.unknown-context-selected(1); } }
                                }
                            }
                        }
                        Rectangle {
                            height: 120px;
                            vertical-stretch: 0;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                ToggleLine {
                                    label: "随 Windows 启动";
                                    note: "使用当前用户的启动项；不会请求管理员权限。";
                                    checked: root.start-with-windows;
                                    toggled(value) => { root.start-with-windows = value; root.startup-toggled(value); }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "WeChatSendGuard " + root.application-version + " · 界面由 Slint 构建";
                                        color: #94a3b8;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                    AppButton {
                                        width: 88px;
                                        label: "关于 Slint";
                                        clicked => { root.about-slint-requested(); }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 185px;
                            vertical-stretch: 0;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 6px;
                                HorizontalLayout {
                                    height: 34px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text { height: 18px; text: "日志与诊断"; color: #0f172a; font-size: 14px; font-weight: 700; }
                                        Text { height: 15px; text: "仅记录拦截状态，不包含消息内容或会话名称。"; color: #64748b; font-size: 11px; overflow: elide; }
                                    }
                                    AppButton { width: 112px; label: "导出诊断日志"; primary: true; clicked => { root.export-diagnostics-requested(); } }
                                }
                                Rectangle { height: 1px; vertical-stretch: 0; background: #e2e8f0; }
                                HorizontalLayout {
                                    height: 34px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    Text { width: 72px; text: "保留时间"; color: #1e293b; font-size: 12px; vertical-alignment: center; }
                                    InputField { width: 72px; value <=> root.log-retention-days; placeholder: "7"; edited => { root.settings-dirty(); } }
                                    Text { width: 140px; text: "天（1–30 天，自动清理）"; color: #64748b; font-size: 11px; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                                }
                                HorizontalLayout {
                                    height: 34px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    Text { width: 72px; text: "日志位置"; color: #1e293b; font-size: 12px; vertical-alignment: center; }
                                    Text { horizontal-stretch: 1; text: root.log-directory; color: #475569; font-size: 11px; vertical-alignment: center; overflow: elide; }
                                    AppButton { width: 100px; label: "打开日志目录"; clicked => { root.open-log-directory-requested(); } }
                                }
                                HorizontalLayout {
                                    height: 34px;
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    Text { width: 72px; text: "维护"; color: #1e293b; font-size: 12px; vertical-alignment: center; }
                                    Text { horizontal-stretch: 1; text: "清空后无法恢复。"; color: #64748b; font-size: 11px; vertical-alignment: center; }
                                    AppButton { width: 88px; label: "清空日志"; danger: true; clicked => { root.clear-logs-requested(); } }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: #00000000; }
                    }
                }

                if (root.active-page == 3) : Rectangle {
                    vertical-stretch: 1;
                    background: #00000000;
                    VerticalLayout {
                        spacing: 12px;
                        Text { height: 28px; text: "关于"; color: #0f172a; font-size: 20px; font-weight: 700; }
                        Text { height: 20px; text: "版本更新只访问 GitHub Releases，不会上传消息、会话或日志。"; color: #64748b; font-size: 12px; }
                        Rectangle {
                            vertical-stretch: 0;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: root.update-available ? #86efac : #e2e8f0;
                            background: root.update-available ? #f0fdf4 : #ffffff;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                Text { height: 22px; text: "WeChatSendGuard " + root.application-version; color: #0f172a; font-size: 16px; font-weight: 700; }
                                Text {
                                    height: 20px;
                                    text: root.update-status-text;
                                    color: root.update-status-error ? #dc2626 : (root.update-available ? #047857 : #475569);
                                    font-size: 12px;
                                    font-weight: 400;
                                    overflow: elide;
                                }
                                if (root.update-available) : Text {
                                    height: 18px;
                                    text: "新版本：v" + root.latest-update-version + " · " + root.latest-update-notes;
                                    color: #475569;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    AppButton { width: 92px; label: "检查更新"; clicked => { root.check-updates-requested(); } }
                                    AppButton {
                                        width: 112px;
                                        visible: root.update-available;
                                        label: "下载并安装";
                                        primary: true;
                                        clicked => { root.download-update-requested(); }
                                    }
                                    AppButton {
                                        width: 96px;
                                        visible: root.update-available;
                                        label: "忽略此版本";
                                        clicked => { root.ignore-update-requested(); }
                                    }
                                    AppButton {
                                        width: 108px;
                                        visible: root.update-available && root.ignored-update-version != "";
                                        label: "取消忽略";
                                        clicked => { root.clear-ignored-update-requested(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: #00000000; }
                                }
                                if (root.update-available && root.ignored-update-version != "") : Text {
                                    height: 18px;
                                    text: "已忽略版本：v" + root.ignored-update-version + "；更高版本仍会提示。";
                                    color: #a16207;
                                    font-size: 11px;
                                }
                            }
                        }
                        Rectangle {
                            height: 78px;
                            vertical-stretch: 0;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            background: #ffffff;
                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;
                                ToggleLine {
                                    label: "启动后自动检查更新";
                                    note: "默认开启；仅检查正式版，不会自动下载或安装。";
                                    checked: root.auto-check-updates;
                                    toggled(value) => { root.auto-check-updates = value; root.auto-check-updates-toggled(value); }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 48px;
                    border-radius: 9px;
                    background: root.save-status-error ? #fef2f2 : #ffffff;
                    border-width: 1px;
                    border-color: root.save-status-error ? #fca5a5 : #e2e8f0;
                    Text {
                        x: 16px;
                        y: 0px;
                        width: parent.width - 156px;
                        height: parent.height;
                        text: root.save-status;
                        color: root.save-status-error ? #dc2626 : #475569;
                        font-size: 12px;
                        font-weight: 400;
                        vertical-alignment: center;
                    }
                    save := AppButton {
                        x: parent.width - 122px;
                        y: 7px;
                        width: 108px;
                        label: "保存设置";
                        primary: true;
                        clicked => { root.save-settings(); }
                    }
                }
            }
            }
        }
    }
}
}
}

export component UpdatePromptWindow inherits Window {
    title: "发现新版本";
    width: 380px;
    height: 178px;
    no-frame: true;
    always-on-top: true;
    background: #ffffff;
    default-font-family: "Microsoft YaHei";
    default-font-size: 13px;
    default-font-weight: 400;

    in-out property <string> update-version: "";
    callback open-about();
    callback dismissed();

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 1px;
        border-color: #86efac;
        background: #ffffff;
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            Text {
                height: 22px;
                text: "发现新版本";
                color: #0f172a;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                height: 20px;
                text: "WeChatSendGuard v" + root.update-version + " 已可用";
                color: #047857;
                font-size: 13px;
                font-weight: 400;
            }
            Text {
                height: 34px;
                text: "可在“关于”页查看说明并选择下载、校验和安装。";
                color: #64748b;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; background: #00000000; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                AppButton { width: 72px; label: "稍后"; clicked => { root.dismissed(); } }
                AppButton { width: 96px; label: "查看更新"; primary: true; clicked => { root.open-about(); } }
            }
        }
    }
}

export component SlintAboutWindow inherits Window {
    title: "关于 Slint";
    width: 340px;
    height: 160px;
    background: #ffffff;

    AboutSlint {
        width: parent.width;
        height: parent.height;
    }
}

export component ConfirmationWindow inherits Window {
    title: "发送确认";
    width: 460px;
    height: 322px + (root.confirmation-mode == 2 ? 40px : 0px);
    no-frame: true;
    always-on-top: true;
    background: #ffffff;
    default-font-family: "Microsoft YaHei";
    default-font-size: 13px;
    default-font-weight: 400;

    in-out property <string> target-kind: "群聊";
    in-out property <string> target-name: "当前会话";
    in-out property <string> draft-preview: "";
    in-out property <bool> draft-preview-ready: false;
    in-out property <int> confirmation-mode: 1;
    in-out property <int> hold-milliseconds: 800;
    in-out property <string> required-phrase: "确认发送";
    in-out property <string> phrase-value: "";
    in-out property <string> confirm-label: "按住确认 (0.8s)";
    in-out property <float> hold-progress: 0;
    in-out property <float> countdown-progress: 100;
    in-out property <string> countdown-text: "10.0 秒后自动取消";
    out property <bool> hold-pressed: hold-area.pressed;
    callback confirmed();
    callback cancelled();
    callback focus-default();

    forward-focus: keyboard-focus;

    keyboard-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                accept
            } else {
                reject
            }
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: #ffffff;
            border-width: 1px;
            border-color: #64748b;
            clip: true;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                alignment: start;
                Rectangle {
                    height: 20px;
                    background: #00000000;
                    Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width - 76px;
                        height: parent.height;
                        text: "发送前确认";
                        color: #0f172a;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: parent.width - 62px;
                        y: 0px;
                        width: 62px;
                        height: 20px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #e2e8f0;
                        background: #f1f5f9;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Esc 取消";
                            color: #64748b;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    height: 60px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #bbf7d0;
                    background: #e8f8f0;
                    Rectangle {
                        x: 12px;
                        y: 20px;
                        width: 42px;
                        height: 20px;
                        border-radius: 4px;
                        background: root.target-kind == "联系人" ? #dcfce7 : #e0f2fe;
                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.target-kind;
                            color: root.target-kind == "联系人" ? #15803d : #0369a1;
                            font-size: 10px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 66px;
                        y: 0px;
                        width: parent.width - 80px;
                        height: parent.height;
                        text: root.target-name;
                        color: #0f172a;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                draft-container := Rectangle {
                    height: 54px;
                    border-radius: 8px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    Text {
                        x: 10px;
                        y: 6px;
                        width: parent.width - 20px;
                        height: 14px;
                        text: "待发送内容";
                        color: #6b7280;
                        font-size: 10px;
                    }
                    Text {
                        x: 10px;
                        y: 22px;
                        width: parent.width - 20px;
                        height: parent.height - 28px;
                        text: root.draft-preview != "" ? root.draft-preview : (root.draft-preview-ready ? "未读取到待发送内容" : "正在读取待发送内容...");
                        color: root.draft-preview != "" ? #111827 : #94a3b8;
                        font-size: 11px;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                }
                phrase-container := Rectangle {
                    height: root.confirmation-mode == 2 ? 40px : 0px;
                    visible: root.confirmation-mode == 2;
                    phrase-field := InputField {
                        width: parent.width;
                        height: root.confirmation-mode == 2 ? 34px : 0px;
                        value <=> root.phrase-value;
                        placeholder: "输入“确认发送”后再确认";
                    }
                }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: #e2e8f0;
                    Rectangle {
                        x: 0px;
                        width: parent.width * root.hold-progress;
                        height: parent.height;
                        border-radius: 2px;
                        background: #07c160;
                        visible: root.confirmation-mode == 1;
                    }
                }
                Rectangle {
                    height: 34px;
                    background: #00000000;
                    AppButton {
                        x: 0px;
                        y: 0px;
                        width: parent.width / 2 - 5px;
                        height: parent.height;
                        label: "取消发送";
                        clicked => { root.cancelled(); }
                    }
                    confirm-button := AppButton {
                        x: parent.width / 2 + 5px;
                        y: 0px;
                        width: parent.width / 2 - 5px;
                        height: parent.height;
                        label: root.confirm-label;
                        primary: true;
                        active: root.confirmation-mode != 2 || root.phrase-value == root.required-phrase;
                        clicked => { if root.confirmation-mode != 1 { root.confirmed(); } }
                    }
                    hold-area := TouchArea {
                        x: confirm-button.x;
                        y: confirm-button.y;
                        width: confirm-button.width;
                        height: confirm-button.height;
                        enabled: root.confirmation-mode == 1;
                    }
                }
                Rectangle {
                    height: 2px;
                    border-radius: 1px;
                    background: #f1f5f9;
                    Rectangle {
                        x: 0px;
                        width: parent.width * root.countdown-progress / 100.0;
                        height: parent.height;
                        border-radius: 1px;
                        background: #f59e0b;
                    }
                }
                Text {
                    height: 18px;
                    text: root.countdown-text;
                    color: #6b7280;
                    font-size: 11px;
                    horizontal-alignment: right;
                }
            }
        }
    }

    focus-default => {
        if (root.confirmation-mode == 2) {
            phrase-field.focus-input();
        } else {
            keyboard-focus.focus();
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: root.protection-enabled ? @image-url("../assets/tray-active.svg") : @image-url("../assets/tray-inactive.svg");
    tooltip: root.status-text;
    title: "WeChatSendGuard";

    in-out property <string> status-text: "状态：正在检测微信";
    in-out property <bool> protection-enabled: true;
    callback open-settings();
    callback add-current-chat();
    callback bypass-requested(int);
    callback protection-toggled(bool);
    callback show-status();
    callback about-slint-requested();
    callback exit-requested();

    clicked => { root.open-settings(); }

    Menu {
        MenuItem { title: root.status-text; enabled: false; }
        MenuSeparator { }
        MenuItem { title: "打开主设置"; activated => { root.open-settings(); } }
        MenuItem { title: "加入当前微信会话"; activated => { root.add-current-chat(); } }
        Menu {
            title: "临时放行当前会话";
            MenuItem { title: "临时放行 1 分钟"; activated => { root.bypass-requested(1); } }
            MenuItem { title: "临时放行 5 分钟"; activated => { root.bypass-requested(5); } }
            MenuItem { title: "临时放行 15 分钟"; activated => { root.bypass-requested(15); } }
        }
        MenuSeparator { }
        MenuItem {
            title: root.protection-enabled ? "发送守护：已启用" : "发送守护：已暂停";
            enabled: false;
        }
        MenuItem {
            title: root.protection-enabled ? "暂停发送守护" : "启用发送守护";
            activated => { root.protection-toggled(!root.protection-enabled); }
        }
        MenuItem { title: "查看当前状态"; activated => { root.show-status(); } }
        MenuItem { title: "关于 Slint"; activated => { root.about-slint-requested(); } }
        MenuSeparator { }
        MenuItem { title: "退出 WeChatSendGuard"; activated => { root.exit-requested(); } }
    }
}
