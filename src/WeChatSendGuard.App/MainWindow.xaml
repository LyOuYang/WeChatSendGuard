<Window x:Class="WeChatSendGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeChatSendGuard 设置"
        Height="680"
        Width="780"
        MinHeight="590"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="WeChatSendGuard" />
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="微信会话消息发送前确认" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Right"
                       Margin="16,6,0,0"
                       VerticalAlignment="Top"
                       FontWeight="SemiBold"
                       Foreground="#1677FF"
                       Text="正在检测微信..." />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,12,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="EnabledCheckBox"
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"
                      Content="启用发送保护"
                      Checked="ImmediateSettingChanged"
                      Unchecked="ImmediateSettingChanged" />
            <StackPanel Grid.Column="2">
                <TextBlock FontWeight="SemiBold" Text="当前模式" />
                <ComboBox x:Name="RuleModeComboBox"
                          Width="360"
                          HorizontalAlignment="Left"
                          SelectionChanged="RuleModeComboBox_SelectionChanged"
                          SelectedValuePath="Value" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="ActiveChatListGroup" Grid.Column="0" Header="需要二次确认的会话" Padding="12">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ActiveListDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <ListBox x:Name="ActiveChatsList"
                             Grid.Row="1"
                             Margin="0,10,0,0"
                             DisplayMemberPath="DisplayNameWithKind"
                             SelectionChanged="ActiveChatsList_SelectionChanged" />
                    <StackPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Click="AddCurrentChatButton_Click" Content="加入当前会话" />
                        <Button Click="RemoveCurrentChatButton_Click" Content="移除选中" />
                        <Button Click="ImportCurrentListButton_Click" Content="导入当前名单" />
                        <Button Click="ExportCurrentListButton_Click" Content="导出当前名单" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="确认与发送入口" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="根据当前模式决定该会话是否需要确认。" TextWrapping="Wrap" />
                        <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="发送入口" />
                        <CheckBox x:Name="KeyboardEnterCheckBox"
                                  Margin="0,6,0,0"
                                  Content="拦截主键盘 Enter"
                                  Checked="ImmediateSettingChanged"
                                  Unchecked="ImmediateSettingChanged" />
                        <CheckBox x:Name="NumpadCheckBox"
                                  Margin="0,8,0,0"
                                  Content="拦截小键盘 Enter"
                                  Checked="ImmediateSettingChanged"
                                  Unchecked="ImmediateSettingChanged" />
                        <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" Text="Shift+Enter 与输入法候选确认始终放行。" TextWrapping="Wrap" />

                        <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="确认方式" />
                        <TextBlock Margin="0,8,0,0" Text="确认模式" />
                        <ComboBox x:Name="ConfirmationModeComboBox" SelectedValuePath="Value" SelectionChanged="ImmediateSettingChanged" />
                        <TextBlock Margin="0,10,0,0" Text="长按时长（毫秒）" />
                        <TextBox x:Name="HoldMillisecondsTextBox" TextChanged="TextSettingChanged" LostFocus="TextSettingLostFocus" />
                        <TextBlock Margin="0,10,0,0" Text="确认词" />
                        <TextBox x:Name="ConfirmationPhraseTextBox" TextChanged="TextSettingChanged" LostFocus="TextSettingLostFocus" />
                        <TextBlock Margin="0,10,0,0" Text="确认窗口超时（秒）" />
                        <TextBox x:Name="TimeoutSecondsTextBox" TextChanged="TextSettingChanged" LostFocus="TextSettingLostFocus" />
                        <TextBlock Margin="0,10,0,0" Text="无法识别会话时" />
                        <ComboBox x:Name="UnknownContextComboBox" SelectedValuePath="Value" SelectionChanged="ImmediateSettingChanged" />
                        <CheckBox x:Name="StartupCheckBox"
                                  Margin="0,12,0,0"
                                  Content="随 Windows 启动"
                                  Checked="ImmediateSettingChanged"
                                  Unchecked="ImmediateSettingChanged" />
                        <TextBlock Margin="0,10,0,0" Text="日志保留天数（1-30）" />
                        <TextBox x:Name="LogRetentionDaysTextBox" TextChanged="TextSettingChanged" LostFocus="TextSettingLostFocus" />
                        <TextBlock Margin="0,12,0,0" Text="选中会话的别名（每行一个）" />
                        <TextBox x:Name="AliasesTextBox"
                                 Height="62"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="TextSettingChanged"
                                 LostFocus="TextSettingLostFocus" />
                        <TextBlock x:Name="CompatibilityHint"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="PrivacyText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="本地运行；草稿仅本次确认显示，不保存" />
            <TextBlock x:Name="AutoSaveStatusText"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="#1677FF"
                       Text="所有更改自动生效" />
        </DockPanel>
    </Grid>
</Window>
