<Window x:Class="WeChatSendGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WeChatSendGuard.App.Converters"
        Title="WeChatSendGuard"
        Icon="Resources/app.ico"
        Height="580"
        Width="920"
        MinHeight="520"
        MinWidth="820"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"
                      ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:ChatTargetKindToTextConverter x:Key="KindToTextConverter" />
        <converters:ChatTargetKindToBadgeBgConverter x:Key="KindToBadgeBgConverter" />
        <converters:ChatTargetKindToBadgeFgConverter x:Key="KindToBadgeFgConverter" />
        <converters:AliasesToSummaryConverter x:Key="AliasesToSummaryConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar (Full Height) -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,14,16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Header / Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="22"
                              Height="22"
                              Fill="{StaticResource AccentBrush}"
                              Data="{StaticResource GeoShield}"
                              Stretch="Uniform"
                              Margin="2,0,10,0"
                              VerticalAlignment="Center" />
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   Text="WeChatSendGuard"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Navigation Tabs with Vector Icons -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <RadioButton x:Name="NavGuardTab"
                                     Style="{StaticResource NavRadioButtonStyle}"
                                     IsChecked="True"
                                     Checked="NavTab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="15"
                                      Height="15"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="{StaticResource GeoList}"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="守护名单" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavRulesTab"
                                     Style="{StaticResource NavRadioButtonStyle}"
                                     Checked="NavTab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="15"
                                      Height="15"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="{StaticResource GeoClock}"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="确认与拦截" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSystemTab"
                                     Style="{StaticResource NavRadioButtonStyle}"
                                     Checked="NavTab_Checked">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="15"
                                      Height="15"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="{StaticResource GeoGear}"
                                      Stretch="Uniform"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="通用设置" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Status Capsule Card at Bottom of Sidebar -->
                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot"
                                     Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText"
                                       Grid.Column="1"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"
                                       Text="正在检测微信..."
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Main Workspace -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Modern Seamless Window Caption Bar -->
                <Grid Grid.Row="0" Background="{StaticResource PanelBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Draggable Window Caption Area -->
                    <Border Background="Transparent" />

                    <!-- Modern Window Controls (Minimize & Close) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource WindowMinButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="最小化" />
                        <Button Style="{StaticResource WindowCloseButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="关闭（缩小至托盘）" />
                    </StackPanel>
                </Grid>

                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="24,0,24,12">
                    <!-- Page 1: Guard List Page -->
                    <Grid x:Name="PageGuardList">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Master Switch -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <CheckBox x:Name="EnabledCheckBox"
                                      VerticalAlignment="Center"
                                      FontWeight="Bold"
                                      FontSize="14"
                                      Content="启用发送保护守护"
                                      Checked="SettingChanged"
                                      Unchecked="SettingChanged" />
                        </Grid>

                        <!-- Dual-State Segmented Mode Selection Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Mode 1: Protect Listed (Default) -->
                            <RadioButton x:Name="RadioProtectListed"
                                         Grid.Column="0"
                                         GroupName="RuleModeGroup"
                                         Style="{StaticResource ModeProtectCardStyle}"
                                         IsChecked="True"
                                         Checked="RuleModeRadio_Checked" />

                            <!-- Mode 2: Confirm Unless Excluded (Global Whitelist) -->
                            <RadioButton x:Name="RadioConfirmUnlessExcluded"
                                         Grid.Column="2"
                                         GroupName="RuleModeGroup"
                                         Style="{StaticResource ModeExemptCardStyle}"
                                         Checked="RuleModeRadio_Checked" />
                        </Grid>

                        <!-- Global Whitelist Warning Banner -->
                        <Border x:Name="GlobalWarningBanner"
                                Grid.Row="2"
                                Margin="0,0,0,8"
                                Padding="10,6"
                                Background="{StaticResource WarningSoftBrush}"
                                BorderBrush="{StaticResource WarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="全局防护中：发给未在下方白名单中的任何微信会话，都将触发二次确认！" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Chat List Card -->
                        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Info -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ActiveChatListTitleText"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource InkBrush}"
                                               Text="受保护的会话名单" />
                                    <Border Grid.Column="1"
                                            Background="{StaticResource PanelAltBrush}"
                                            CornerRadius="10"
                                            Padding="8,2">
                                        <TextBlock x:Name="ActiveListCountText"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="0 个会话" />
                                    </Border>
                                </Grid>

                                <ListBox x:Name="ActiveChatsList"
                                         Grid.Row="1"
                                         SelectionMode="Extended"
                                         SelectionChanged="ActiveChatsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Target Kind Badge -->
                                                <Border CornerRadius="4"
                                                        Padding="6,2"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding TargetKind, Converter={StaticResource KindToBadgeBgConverter}}">
                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding TargetKind, Converter={StaticResource KindToBadgeFgConverter}}"
                                                               Text="{Binding TargetKind, Converter={StaticResource KindToTextConverter}}" />
                                                </Border>

                                                <!-- Title & Aliases -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Text="{Binding Aliases, Converter={StaticResource AliasesToSummaryConverter}}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="EmptyListHint"
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="暂无会话，请点击下方「+ 加入当前微信会话」" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Inline Aliases Input -->
                        <Border Grid.Row="4"
                                Margin="0,6,0,0"
                                Padding="10,5"
                                Background="{StaticResource PanelAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AliasesHintText"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="匹配别名 (逗号或换行):"
                                           Margin="0,0,8,0" />
                                <TextBox x:Name="AliasesTextBox"
                                         Grid.Column="1"
                                         Height="28"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontSize="12"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="TextSettingChanged" />
                            </Grid>
                        </Border>

                        <!-- Action Buttons Toolbar -->
                        <Grid Grid.Row="5" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddCurrentChatButton"
                                    Height="34"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="AddCurrentChatButton_Click"
                                    Content="+ 加入当前微信会话" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Margin="0,0,6,0"
                                        Height="34"
                                        Width="64"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RemoveCurrentChatButton_Click"
                                        Content="移除" />
                                <Button Margin="0,0,6,0"
                                        Height="34"
                                        Width="64"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="ImportCurrentListButton_Click"
                                        Content="导入" />
                                <Button Height="34"
                                        Width="64"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="ExportCurrentListButton_Click"
                                        Content="导出" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Page 2: Confirmation Preferences -->
                    <StackPanel x:Name="PageRules" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Text="二次确认方式" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" Text="确认方式" />
                                    <ComboBox x:Name="ConfirmationModeComboBox"
                                              Grid.Column="1"
                                              Height="32"
                                              SelectedValuePath="Value"
                                              SelectionChanged="ConfirmationModeComboBox_SelectionChanged" />

                                    <!-- Hold Duration (Only in Hold mode) -->
                                    <TextBlock x:Name="HoldMillisecondsLabel" Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center" Text="长按时长" />
                                    <StackPanel x:Name="HoldMillisecondsPanel" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Orientation="Horizontal">
                                        <TextBox x:Name="HoldMillisecondsTextBox"
                                                 Width="90"
                                                 Height="32"
                                                 MaxLength="4"
                                                 TextAlignment="Right"
                                                 ToolTip="500 至 3000 毫秒"
                                                 TextChanged="TextSettingChanged" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="毫秒 (推荐 800ms，按住进度完成即发送)" />
                                    </StackPanel>

                                    <!-- Confirmation Phrase (Only in Phrase mode) -->
                                    <TextBlock x:Name="PhraseLabel" Grid.Row="2" Margin="0,12,0,0" VerticalAlignment="Center" Text="确认词" Visibility="Collapsed" />
                                    <StackPanel x:Name="PhrasePanel" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Orientation="Horizontal" Visibility="Collapsed">
                                        <TextBox x:Name="ConfirmationPhraseTextBox"
                                                 Width="160"
                                                 Height="32"
                                                 TextChanged="TextSettingChanged" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="弹窗中输入该词后解锁发送" />
                                    </StackPanel>

                                    <!-- Timeout (Always visible) -->
                                    <TextBlock Grid.Row="3" Margin="0,12,0,0" VerticalAlignment="Center" Text="超时取消等待" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Orientation="Horizontal">
                                        <TextBox x:Name="TimeoutSecondsTextBox"
                                                 Width="90"
                                                 Height="32"
                                                 MaxLength="2"
                                                 TextAlignment="Right"
                                                 ToolTip="1 至 30 秒"
                                                 TextChanged="TextSettingChanged" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="秒后自动取消拦截" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Trigger Interception -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Text="触发按键拦截" />
                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                    <CheckBox x:Name="KeyboardEnterCheckBox"
                                              Content="主键盘 Enter"
                                              Checked="SettingChanged"
                                              Unchecked="SettingChanged" />
                                    <CheckBox x:Name="NumpadCheckBox"
                                              Margin="28,0,0,0"
                                              Content="小键盘 Enter"
                                              Checked="SettingChanged"
                                              Unchecked="SettingChanged" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="Shift+Enter 换行与输入法候选确认始终直接放行。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Page 3: General System Settings -->
                    <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18,16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Text="系统行为" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock VerticalAlignment="Center" Text="未识别会话时" />
                                    <ComboBox x:Name="UnknownContextComboBox"
                                              Grid.Column="1"
                                              Height="32"
                                              SelectedValuePath="Value"
                                              SelectionChanged="SettingChanged" />

                                    <CheckBox x:Name="StartupCheckBox"
                                              Grid.Row="1"
                                              Grid.ColumnSpan="2"
                                              Margin="0,16,0,0"
                                              Content="随 Windows 开机自动启动"
                                              Checked="SettingChanged"
                                              Unchecked="SettingChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="18,16">
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Text="日志与诊断" />
                                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="日志保留天数:" Margin="0,0,10,0" />
                                    <TextBox x:Name="LogRetentionDaysTextBox"
                                             Width="60"
                                             Height="32"
                                             MaxLength="2"
                                             TextAlignment="Center"
                                             TextChanged="TextSettingChanged" />
                                    <TextBlock VerticalAlignment="Center" Text="天" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Bottom Shared Save Action Bar -->
                <Grid Grid.Row="2" Margin="24,0,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SaveStatusText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"
                               Text="就绪" />

                    <Button x:Name="SaveSettingsButton"
                            Grid.Column="1"
                            MinWidth="110"
                            Height="34"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SaveSettingsButton_Click"
                            Content="保存设置" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
