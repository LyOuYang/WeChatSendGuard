<Window x:Class="WeChatSendGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeChatSendGuard 设置"
        Height="720"
        Width="920"
        MinHeight="620"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="WeChatSendGuard" />
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="微信会话消息发送前确认" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Right"
                       Margin="16,6,0,0"
                       VerticalAlignment="Top"
                       FontWeight="SemiBold"
                       Foreground="#1677FF"
                       Text="正在检测微信..." />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="EnabledCheckBox"
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"
                      Content="启用发送保护"
                      Checked="SettingChanged"
                      Unchecked="SettingChanged" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="名单模式" />
                <ComboBox x:Name="RuleModeComboBox"
                          MinWidth="390"
                          HorizontalAlignment="Left"
                          SelectionChanged="RuleModeComboBox_SelectionChanged"
                          SelectedValuePath="Value" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="ActiveChatListGroup" Grid.Column="0" Header="需要二次确认的会话" Padding="12">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ActiveListDescription" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <ListBox x:Name="ActiveChatsList"
                             Grid.Row="1"
                             Margin="0,10,0,0"
                             DisplayMemberPath="DisplayNameWithKind"
                             SelectionMode="Extended"
                             SelectionChanged="ActiveChatsList_SelectionChanged" />
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Click="AddCurrentChatButton_Click" Content="加入当前会话" />
                        <Button Click="RemoveCurrentChatButton_Click" Content="移除选中项" />
                        <Button Click="ImportCurrentListButton_Click" Content="导入当前名单" />
                        <Button Click="ExportCurrentListButton_Click" Content="导出当前名单" />
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="确认与发送入口" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="根据当前模式决定该会话是否需要确认。" TextWrapping="Wrap" />
                        <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="发送入口" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <CheckBox x:Name="KeyboardEnterCheckBox"
                                      Content="拦截主键盘 Enter"
                                      Checked="SettingChanged"
                                      Unchecked="SettingChanged" />
                            <CheckBox x:Name="NumpadCheckBox"
                                      Margin="20,0,0,0"
                                      Content="拦截小键盘 Enter"
                                      Checked="SettingChanged"
                                      Unchecked="SettingChanged" />
                        </StackPanel>
                        <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" Text="Shift+Enter 与输入法候选确认始终放行。" TextWrapping="Wrap" />

                        <Separator Margin="0,16,0,0" />
                        <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="确认规则" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="确认模式" />
                            <ComboBox x:Name="ConfirmationModeComboBox"
                                      Grid.Column="1"
                                      SelectedValuePath="Value"
                                      SelectionChanged="SettingChanged" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="长按时长（毫秒）" />
                            <TextBox x:Name="HoldMillisecondsTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     MaxLength="4"
                                     TextAlignment="Right"
                                     ToolTip="500 至 3000"
                                     TextChanged="TextSettingChanged" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="确认词" />
                            <TextBox x:Name="ConfirmationPhraseTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     TextChanged="TextSettingChanged" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="确认窗口超时（秒）" />
                            <TextBox x:Name="TimeoutSecondsTextBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     MaxLength="2"
                                     TextAlignment="Right"
                                     ToolTip="1 至 30"
                                     TextChanged="TextSettingChanged" />
                        </Grid>

                        <Separator Margin="0,16,0,0" />
                        <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="运行设置" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="无法识别会话时" />
                            <ComboBox x:Name="UnknownContextComboBox"
                                      Grid.Column="1"
                                      SelectedValuePath="Value"
                                      SelectionChanged="SettingChanged" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="日志保留天数" />
                            <TextBox x:Name="LogRetentionDaysTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     MaxLength="2"
                                     TextAlignment="Right"
                                     ToolTip="1 至 30"
                                     TextChanged="TextSettingChanged" />
                            <CheckBox x:Name="StartupCheckBox"
                                      Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      Margin="0,8,0,0"
                                      Content="随 Windows 启动"
                                      Checked="SettingChanged"
                                      Unchecked="SettingChanged" />
                        </Grid>

                        <Separator Margin="0,16,0,0" />
                        <TextBlock Margin="0,14,0,0" Text="选中会话的别名（每行一个）" />
                        <TextBox x:Name="AliasesTextBox"
                                 Height="62"
                                 Margin="0,6,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="TextSettingChanged" />
                        <TextBlock x:Name="CompatibilityHint"
                                   Margin="0,14,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PrivacyText"
                           Foreground="{StaticResource MutedBrush}"
                           Text="本地运行；草稿仅本次确认显示，不保存" />
                <TextBlock x:Name="SaveStatusText"
                           Grid.Column="1"
                           Margin="18,0,0,0"
                           Foreground="#667085"
                           TextTrimming="CharacterEllipsis"
                           Text="确认设置后点击保存" />
            </Grid>
            <Button x:Name="SaveSettingsButton"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    MinWidth="116"
                    Background="#1677FF"
                    Foreground="White"
                    Click="SaveSettingsButton_Click"
                    Content="保存设置" />
        </Grid>
    </Grid>
</Window>
