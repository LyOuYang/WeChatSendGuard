<Window x:Class="WeChatSendGuard.App.Windows.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发送确认"
        Width="460"
        SizeToContent="Height"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="ConfirmationWindow_KeyDown">

    <Border Margin="14"
            Padding="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Color="#000000"
                              Opacity="0.14"
                              ShadowDepth="4"
                              Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header with Vector Green Shield -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="18"
                          Height="18"
                          Fill="{StaticResource AccentBrush}"
                          Data="{StaticResource GeoShield}"
                          Stretch="Uniform"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                    <TextBlock FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}"
                               Text="发送前确认"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Esc 取消" />
                </Border>
            </Grid>

            <!-- Target Hero Card -->
            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="12,10"
                    Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="#BBF7D0"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TargetKindBadge"
                            Background="{StaticResource BadgeGroupBgBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TargetKindText"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BadgeGroupFgBrush}"
                                   Text="群聊" />
                    </Border>

                    <TextBlock x:Name="TargetText"
                               Grid.Column="1"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}"
                               Text="当前会话"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Draft Content Preview -->
            <Border x:Name="DraftPreviewPanel"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="12,10"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="待发送内容" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,4,0,0"
                                  MaxHeight="100"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DraftPreviewText"
                                   Foreground="{StaticResource InkBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Phrase Verification Box (Only for Phrase Mode) -->
            <TextBox x:Name="PhraseBox"
                     Grid.Row="3"
                     Margin="0,10,0,0"
                     Padding="10,6"
                     Visibility="Collapsed"
                     MaxLength="32" />

            <!-- Hold Progress Visual Bar (Only during active holding) -->
            <ProgressBar x:Name="HoldProgress"
                         Grid.Row="4"
                         Height="4"
                         Margin="0,10,0,0"
                         Minimum="0"
                         Maximum="100"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource PanelAltBrush}"
                         BorderThickness="0"
                         Visibility="Collapsed" />

            <!-- Action Buttons & Countdown Footer -->
            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Action Buttons -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Grid.Column="1"
                            IsCancel="True"
                            MinWidth="90"
                            Height="34"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"
                            Content="取消发送" />

                    <Button x:Name="ConfirmButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            MinWidth="120"
                            Height="34"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ConfirmButton_Click"
                            Content="确认发送" />
                </Grid>

                <!-- Clean Countdown Sub-bar -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="CountdownProgress"
                                 Height="2"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="100"
                                 Foreground="{StaticResource BorderHoverBrush}"
                                 Background="#F1F5F9"
                                 BorderThickness="0" />
                    <TextBlock x:Name="CountdownText"
                               Grid.Column="1"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="10 秒后自动取消" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
