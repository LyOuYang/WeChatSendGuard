<Window x:Class="WeChatSendGuard.App.Windows.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发送确认"
        Width="480"
        SizeToContent="Height"
        MinHeight="300"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#1B2028"
        Foreground="#F4F7FB">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#EAF0F7" />
            <Setter Property="Background" Value="#374354" />
            <Setter Property="BorderBrush" Value="#536176" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#475770" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B3442" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#168764" />
            <Setter Property="BorderBrush" Value="#31B58C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Border Margin="1" Background="#1B2028" BorderBrush="#3C4655" BorderThickness="1" CornerRadius="6">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="确认发送消息" />
                <TextBlock Margin="0,5,0,0" Foreground="#B6C1D0" Text="请确认发送目标与本次草稿内容。" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,18,0,0" Padding="14" Background="#272E38" BorderBrush="#3B4656" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                    <TextBlock Foreground="#AAB7C8" FontSize="12" Text="发送到" />
                    <TextBlock x:Name="TargetText"
                               Margin="0,4,0,0"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#FFD089"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="DraftPreviewPanel"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="14"
                    Background="#222933"
                    BorderBrush="#3B4656"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="#AAB7C8" FontSize="12" Text="待发送内容（仅本次显示，不保存）" />
                    <ScrollViewer Grid.Row="1" Margin="0,7,0,0" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DraftPreviewText" Foreground="#F4F7FB" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,18,0,0">
                <TextBlock x:Name="InstructionText" Foreground="#C3CDD9" TextWrapping="Wrap" />
                <ProgressBar x:Name="HoldProgress"
                             Height="7"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="100"
                             Foreground="#29B788"
                             Background="#344050"
                             Visibility="Collapsed" />
                <TextBox x:Name="PhraseBox"
                         Margin="0,12,0,0"
                         Padding="9,6"
                         Background="#11161D"
                         BorderBrush="#536176"
                         Foreground="#F4F7FB"
                         CaretBrush="#F4F7FB"
                         Visibility="Collapsed"
                         MaxLength="32" />
            </StackPanel>

            <TextBlock x:Name="CountdownText"
                       Grid.Row="4"
                       Margin="0,14,0,0"
                       Foreground="#98A7BA" />

            <StackPanel Grid.Row="5" Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Click="CancelButton_Click" Content="取消发送" />
                <Button x:Name="ConfirmButton" Margin="10,0,0,0" Click="ConfirmButton_Click" Content="确认发送" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
